---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import headerBg from '../../assets/photos/photo-30.jpg';

// Blog posts, newest first
const posts = [
  {
    href: '/blog/mendenhall-river-glofs',
    date: 'Aug 21, 2026',
    title: 'Mendenhall River GLOFs: Suicide Basin, the data, and Juneau\'s response',
    excerpt: 'A hazard that did not exist before 2011, four annual outburst floods in a row, and what the USGS and NWS records show about the 2026 event.',
    tags: ['GLOF', 'HEC-HMS', 'HEC-RAS', 'hydrology', 'Alaska'],
  },
  {
    href: '/blog/the-story-behind-rang',
    date: 'Aug 2, 2026',
    title: 'The story behind Rang',
    excerpt: 'How Persian art, and a silk carpet from Kashan in particular, became a set of color palettes I now use in engineering maps.',
    tags: ['color', 'visualization', 'Persian art'],
  },
];
---

<Base title="Blog" description="Short posts by Dr. Mohsen Tahmasebi Nasab on hydrology, hydraulics, visualization, and what I am thinking about.">
  <PageHeader
    eyebrow="// writing"
    title="Blog"
    lede="A space for what I am thinking about, technical or otherwise. Short posts, the kind of thing I wish I had found when I was figuring it out."
    bgImage={headerBg}
    bgPos="center 45%"
  />

  <section class="section">
    <div class="wrap">
      <ol class="entry-list">
        {posts.map((p) => (
          <li class="entry">
            <div class="entry-year">{p.date}</div>
            <div class="entry-body">
              <h3><a href={p.href}>{p.title}</a></h3>
              <p class="muted" style="margin:.15rem 0 .6rem">{p.excerpt}</p>
              <div class="chips">{p.tags.map((t) => <span class="chip">{t}</span>)}</div>
              <p style="margin-top:.7rem"><a class="card-arrow" href={p.href}>Read the post
                <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a></p>
            </div>
          </li>
        ))}
      </ol>

      <p class="faint" style="margin-top:2rem;font-size:.86rem">
        Have a question a post should answer, or a topic you would like me to write about? <a href="mailto:mohsen.tahmasebi.n@gmail.com">Email me</a>.
        See also the <a href="/media">media page</a> for interviews and press.
      </p>
    </div>
  </section>
</Base>
