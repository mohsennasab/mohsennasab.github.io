<script is:inline>
  (function () {
    // Before/after swipe sliders
    function initSwipes() {
      document.querySelectorAll('[data-swipe]:not([data-swipe-ready])').forEach(function (box) {
        var top = box.querySelector('[data-swipe-top]');
        var range = box.querySelector('[data-swipe-range]');
        if (!top || !range) return;
        function set(v) { top.style.width = v + '%'; }
        range.addEventListener('input', function () { set(range.value); });
        set(range.value);
        box.setAttribute('data-swipe-ready', '1');
      });
    }

    // Lightbox: click a static plot to enlarge
    var overlay = null, overlayImg = null;
    function ensureOverlay() {
      if (overlay) return;
      overlay = document.createElement('div');
      overlay.className = 'lightbox';
      overlay.setAttribute('role', 'dialog');
      overlay.setAttribute('aria-modal', 'true');
      overlay.setAttribute('aria-label', 'Enlarged figure');
      overlayImg = document.createElement('img');
      overlayImg.className = 'lightbox-img';
      overlayImg.alt = '';
      var closeBtn = document.createElement('button');
      closeBtn.type = 'button';
      closeBtn.className = 'lightbox-close';
      closeBtn.setAttribute('aria-label', 'Close enlarged view');
      closeBtn.innerHTML = '&times;';
      overlay.appendChild(overlayImg);
      overlay.appendChild(closeBtn);
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay || e.target === closeBtn) closeLightbox();
      });
      document.body.appendChild(overlay);
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') closeLightbox();
      });
    }
    function largestFromSrcset(img) {
      var srcset = img.getAttribute('srcset');
      if (!srcset) return img.currentSrc || img.src;
      var best = { url: img.currentSrc || img.src, w: 0 };
      srcset.split(',').forEach(function (s) {
        var parts = s.trim().split(/\s+/);
        var w = parseInt((parts[1] || '0').replace(/w$/, ''), 10) || 0;
        if (w >= best.w) { best = { url: parts[0], w: w }; }
      });
      return best.url;
    }
    function openLightbox(img) {
      ensureOverlay();
      overlayImg.src = largestFromSrcset(img);
      overlayImg.alt = img.alt || '';
      overlay.classList.add('lightbox-open');
      document.body.style.overflow = 'hidden';
    }
    function closeLightbox() {
      if (!overlay) return;
      overlay.classList.remove('lightbox-open');
      document.body.style.overflow = '';
    }
    function initLightbox() {
      document.querySelectorAll('.post-fig:not([data-lightbox-ready])').forEach(function (fig) {
        // Skip figures whose content is a GIF or a <video>
        if (fig.querySelector('video')) { fig.setAttribute('data-lightbox-ready', '1'); return; }
        var img = fig.querySelector('img');
        if (!img) { fig.setAttribute('data-lightbox-ready', '1'); return; }
        var src = img.getAttribute('src') || '';
        if (src.indexOf('.gif') !== -1) { fig.setAttribute('data-lightbox-ready', '1'); return; }
        fig.setAttribute('data-zoomable', '1');
        img.setAttribute('role', 'button');
        img.setAttribute('tabindex', '0');
        img.setAttribute('aria-label', 'Click to enlarge');
        img.addEventListener('click', function () { openLightbox(img); });
        img.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLightbox(img); }
        });
        fig.setAttribute('data-lightbox-ready', '1');
      });
    }

    function init() { initSwipes(); initLightbox(); }
    document.addEventListener('astro:page-load', init);
    init();
  })();
</script>
