<Base
  title="Mendenhall River GLOFs"
  description="Suicide Basin, the data, and Juneau's response to the recurring Mendenhall River glacial-lake outburst floods. A data-driven post by Dr. Mohsen Tahmasebi Nasab."
>
  <div class="post-hero-tall">
    <PageHeader
      eyebrow="// blog"
      title="Mendenhall River GLOFs"
      lede="Suicide Basin, the data, and Juneau's response."
      bgImage={headerBg}
      bgPos="center 50%"
    >
      <p class="post-byline">Mohsen Tahmasebi Nasab, PhD</p>
      <p class="post-meta">Aug 21, 2026 · about a 12 minute read</p>
    </PageHeader>
  </div>

  <article class="section">
    <div class="wrap post">

      <!-- Opening swipe: 1893 vs 2018 -->
      <figure class="swipe-fig">
        <div class="swipe-cue" role="note">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 6L3 12l5 6M16 6l5 6-5 6M3 12h18"/></svg>
